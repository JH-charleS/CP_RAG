# =========================
# Application
# =========================
APP_NAME=CP_RAG
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# =========================
# Redis
# =========================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_PREFIX=cp_rag
REDIS_MAX_CONNECTIONS=100

# =========================
# MySQL
# =========================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=cp_rag
MYSQL_CHARSET=utf8mb4
MYSQL_MIN_SIZE=1
MYSQL_MAX_SIZE=10
MYSQL_CONNECT_TIMEOUT=10
MYSQL_AUTOCOMMIT=false

# =========================
# Milvus
# =========================
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB_NAME=default
MILVUS_TIMEOUT=10
MILVUS_SECURE=false
MILVUS_COLLECTION=cp_rag_solutions
