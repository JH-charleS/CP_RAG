# =========================
# Application
# =========================
APP_NAME=CP_RAG
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# =========================
# Redis
# =========================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_PREFIX=cp_rag
REDIS_MAX_CONNECTIONS=100
REDIS_CACHE_SIMILARITY_THRESHOLD=0.95
REDIS_CACHE_MAX_ENTRIES=2000

# =========================
# MySQL（与 docker-compose 中 cp-mysql 一致：库 cp_rag_db，492 条题解在表 solutions）
# 应用跑在宿主机时用 127.0.0.1；用户可用 root 或 admin（见 compose 环境变量）
# =========================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=admin
MYSQL_PASSWORD=123456
MYSQL_DB=cp_rag_db
MYSQL_CHARSET=utf8mb4
MYSQL_MIN_SIZE=1
MYSQL_MAX_SIZE=10
MYSQL_CONNECT_TIMEOUT=10
MYSQL_AUTOCOMMIT=false

# =========================
# Milvus
# =========================
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB_NAME=default
MILVUS_TIMEOUT=10
MILVUS_SECURE=false
MILVUS_COLLECTION=cp_rag_solutions
MILVUS_VECTOR_FIELD=embedding
MILVUS_TEXT_FIELD=context
MILVUS_OUTPUT_FIELDS=id,title,context,source

# =========================
# Embedding / RAG
# =========================
EMBEDDING_MODEL_NAME=BAAI/bge-m3
RAG_TOP_K=2

# =========================
# LLM API
# =========================
LLM_PROVIDER=openai_compatible
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# =========================
# V2 (LangChain + MultiModal + Intent)
# =========================
V2_API_PREFIX=/api/v2
V2_MILVUS_COLLECTION=cp_rag_document_v2
V2_PARENT_CHUNK_SIZE=512
V2_PARENT_CHUNK_OVERLAP=64
V2_CHILD_CHUNK_SIZE=128
V2_CHILD_CHUNK_OVERLAP=32
V2_RAG_TOP_K=4
V2_QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
V2_QWEN_API_KEY=your_qwen_api_key_here
V2_QWEN_TEXT_MODEL=qwen-plus
V2_QWEN_VISION_MODEL=qwen-vl-plus
V2_BERT_CLASSIFIER_MODEL_PATH=D:\S\heimatool\RAG\integrated_qa_system\rag_qa\models\bert_query_classifier
